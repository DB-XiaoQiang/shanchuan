<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Shanchuan.GuiUpdateSmoke</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Shanchuan.Core/Shanchuan.Core.csproj" />
    <Compile Include="../../src/Shanchuan.Windows/Services/WindowsCredentialStore.cs" Link="WindowsCredentialStore.cs" />
    <Compile Include="../../src/Shanchuan.Windows/GlobalUsings.cs" Link="GlobalUsings.cs" />
  </ItemGroup>
</Project>
