<Window x:Class="Shanchuan.Windows.DirectoryRulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="目录排除规则" AutomationProperties.AutomationId="DirectoryRulesWindow"
        Width="820" Height="600" MinWidth="640" MinHeight="440"
        ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" Background="#F3F6FB" Foreground="#172033">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,12">
            <TextBlock Text="目录排除规则" FontSize="22" FontWeight="SemiBold" />
            <TextBlock Text="每行一条；末尾 / 只排除文件夹，支持 *、?、** 和相对路径。以 # 开头的行作为注释。"
                       TextWrapping="Wrap" Foreground="#667085" Margin="0,8,0,0" />
            <TextBlock Text="修改即自动保存；“完成”会保存最后输入并关闭。" Foreground="#667085" Margin="0,5,0,0" />
        </StackPanel>
        <TextBox x:Name="RulesEditor" Grid.Row="1" AutomationProperties.AutomationId="DirectoryRulesEditor"
                 Text="{Binding Settings.DirectoryExclusionRules, UpdateSourceTrigger=PropertyChanged}"
                 TextChanged="RulesEdited" AcceptsReturn="True" TextWrapping="NoWrap"
                 HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" FontFamily="Consolas" FontSize="14" Padding="12" />
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock x:Name="RuleValidation" AutomationProperties.AutomationId="DirectoryRulesValidation"
                       Visibility="Collapsed" TextWrapping="Wrap" Foreground="#B42318" Margin="0,0,0,8" />
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel>
                    <Button Content="添加常用规则" AutomationProperties.AutomationId="EditorAddCommonRules"
                            Click="AddCommonRulesClicked" HorizontalAlignment="Left" Margin="0,0,0,4" />
                    <TextBlock Text="{Binding SettingsStatus}" Foreground="#667085" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Content="完成" AutomationProperties.AutomationId="CompleteDirectoryRules"
                        Click="Complete" VerticalAlignment="Bottom" Margin="16,0,0,0"
                        Background="#2563EB" Foreground="White" MinWidth="88" />
            </Grid>
        </Grid>
    </Grid>
</Window>
