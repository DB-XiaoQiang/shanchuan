<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Localization/*.json" LogicalName="Localization.%(Filename).json" />
    <EmbeddedResource Include="../../../Resources/update-public-key.pem" LogicalName="UpdateSigningPublicKey.pem" />
    <PackageReference Include="FluentFTP" Version="55.1.0" />
  </ItemGroup>
</Project>
